      "source": [
        "class Human:\n",
        "\n",
        "    def __init__(self, name, age):\n",
        "        self.name = name\n",
        "        self.age = age\n",
        "\n",
        "    def printinfo(self):\n",
        "        print(\"名前:\", self.name)\n",
        "        print(\"年齢:\", self.age)\n",
        "\n",
        "# インスタンスを作成\n",
        "human1 = Human(\"山田太郎\", 25)\n",
        "\n",
        "# メソッドを実行\n",
        "human1.printinfo()"
      ]
    }
